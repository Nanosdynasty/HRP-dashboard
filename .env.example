# Optional live AIS tracking. Never commit a real key.
AISSTREAM_API_KEY=

# Microsoft login (required by default). No real secrets in this file.
# See docs/microsoft-access.md for registration and one-time owner bootstrap.
AUTH_BASE_URL=http://localhost:8000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
AUTH_ADMIN_ISSUER=
AUTH_ADMIN_SUBJECT=
# HRP Entra SSO cutover. Keep false until IT has registered the HRP app,
# uploaded the public certificate, assigned roles and tested an HRP admin.
# The private key is generated on each host and never placed in source control.
HRP_SSO_ENABLED=false
HRP_ENTRA_TENANT_ID=
HRP_ENTRA_CLIENT_ID=
HRP_ENTRA_EMAIL_DOMAINS=
HRP_ENTRA_CERT_PATH=
HRP_ENTRA_PRIVATE_KEY_PATH=
# Explicit loopback-only development/test opt-out; ignored in production.
APP_AUTH_ENABLED=true
# Any verified Microsoft work/personal account may request access; owner approval is required.
# Separate private Fernet key. See docs/company-access.md; retain it across restarts.
AUTH_MFA_ENCRYPTION_KEY=

# Optional Google verification for Gmail access requests. Create a Google OAuth
# Web application with /auth/google/callback as its authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 authentication mail. Use a separate app registration and scope
# Application Mail.Send to only MS365_MAIL_SENDER using Exchange application RBAC.
# Do not put real secrets in source control.
MS365_MAIL_TENANT_ID=
MS365_MAIL_CLIENT_ID=
MS365_MAIL_CLIENT_SECRET=
MS365_MAIL_SENDER=

# Alternative for an owner's personal Outlook.com mailbox. This uses owner
# consent to delegated Mail.Send through the existing Microsoft web app, then
# stores the refresh token encrypted in persistent access storage. Register
# /auth/mail/callback on the Microsoft app before connecting the mailbox.
MAIL_PERSONAL_SENDER=

# Server-side NewsData.io credential for the project-focused news workspace.
# Never add a real key to git or client-side JavaScript.
NEWS_DATA_API_KEY=
NEWS_API_KEY=
# Shared cache period; protects the provider quota from repeated page loads.
NEWS_CACHE_TTL_SECONDS=1800

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional local OpenAI-compatible model endpoint.
